#!/bin/sh
# Ediff two files in a standalone terminal Emacs (emacs -nw), apart from Emacs.app.
# Quitting ediff exits this Emacs.

el=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
er=$(printf '%s' "$2" | sed 's/\\/\\\\/g; s/"/\\"/g')

form="(progn
  (setq ediff-window-setup-function 'ediff-setup-windows-plain
        ediff-split-window-function 'split-window-horizontally
        ;; This Emacs exits on quit, so do not ask to kill the two buffers.
        ediff-keep-variants t)
  (add-hook 'ediff-quit-hook #'kill-emacs 90)
  (ediff-files \"$el\" \"$er\"))"

exec emacs -nw --eval "$form"
